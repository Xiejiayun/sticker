# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Database (Neon PostgreSQL) ===
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# === Auth (Better Auth) ===
BETTER_AUTH_SECRET=replace-with-32-char-random-secret
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional build-only flag for CI; omit locally to infer availability from credentials.
# GOOGLE_AUTH_ENABLED=true

# === Object Storage (Cloudflare R2) ===
# Bucket is bound as STICKER_IMAGES in wrangler.jsonc; no S3 access keys needed.
# Use a random secret of at least 32 characters for short-lived image permissions.
R2_SIGNING_SECRET=

# === AI Image Generation (Pluggable Relay Provider) ===
# Supported: mock | openai-relay | gemini-relay
AI_IMAGE_PROVIDER=mock
AI_IMAGE_API_BASE=https://openrouter.ai/api/v1
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=google/gemini-3-pro-image-preview

# === Optional LLM Prompt Enhancer ===
LLM_ENHANCE_ENABLED=false
LLM_ENHANCE_API_BASE=https://openrouter.ai/api/v1
LLM_ENHANCE_API_KEY=
LLM_ENHANCE_MODEL=google/gemini-2.5-flash

# === Credits Configuration ===
CREDITS_SIGNUP_BONUS=20
CREDITS_COST_3X3=10
CREDITS_COST_4X4=15

# === Payments (Stripe) ===
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
