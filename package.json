{
  "name": "stickerjam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:storage": "node --test tests/storage.test.mjs",
    "test:references": "node --test tests/reference-images.test.mjs",
    "test:generation": "node --test tests/generation.test.mjs",
    "test:product": "node --test tests/grid.test.mjs tests/prompt.test.mjs",
    "test:slicer": "node scripts/test-slicer.mjs",
    "test:home-ui": "node --test tests/home-entry.browser.mjs",
    "test:verification-ui": "node --test tests/verification-prompt.browser.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "cf:types": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv --include-main-module=false",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "cf:build": "opennextjs-cloudflare build && node scripts/prepare-static.mjs",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:upload": "opennextjs-cloudflare upload",
    "cf:deploy": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.782.0",
    "@aws-sdk/s3-request-presigner": "^3.782.0",
    "@neondatabase/serverless": "^1.0.0",
    "@opennextjs/cloudflare": "^1.2.1",
    "better-auth": "^1.2.7",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "next-intl": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^18.1.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.23"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "drizzle-kit": "^0.31.1",
    "playwright-core": "1.65.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "wrangler": "^4.16.1"
  }
}
